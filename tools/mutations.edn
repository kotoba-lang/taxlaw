;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file` —
;; `tools/mutate.cljs` refuses otherwise, because a mutation that landed in a
;; comment or in a second call site produces a red suite that proves nothing.
;;
;; ## SCOPE — this table does not cover the whole library
;;
;; It covers two facets: the 検索要件 pair (`book-search` /
;; `electronic-transaction-search`) and 消費税額等 (`consumption-tax-amount`,
;; 消費税法施行令 第七十条の十). The invoice-registration, retention,
;; preservation, withholding and year-end-adjustment facets have suites but
;; no mutations here, so a clean run means "every invariant of THOSE TWO
;; facets is measured" and NOT "every invariant of taxlaw is measured".
;; Reading it as the second would be the defect the harness exists to catch:
;; a check that did not look reporting the same value as one that looked and
;; found nothing.
[{:id :undeclared-claim-is-not-a-pass
  :invariant "books that do not say whether they claim 法第八条第四項 get :not-declared"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (nil? (:claiming-preferential-treatment? books))\n      {:taxlaw/coverage :not-declared"
  :replace "      (nil? (:claiming-preferential-treatment? nil))\n      {:taxlaw/coverage :not-declared"}

 {:id :not-claiming-is-not-satisfying
  :invariant "`the rule does not reach you` is not `you satisfy the rule`"
  :file "src/kotoba/taxlaw.cljc"
  :find "       :taxlaw/search-required? false\n       :taxlaw/adequate? nil"
  :replace "       :taxlaw/search-required? false\n       :taxlaw/adequate? true"}

 {:id :all-three-record-items-are-required
  :invariant "取引年月日・取引金額・取引先 — every one of them"
  :file "src/kotoba/taxlaw.cljc"
  :find "           (not (every? items (:rule/record-items rule))))"
  :replace "           (not (some items (:rule/record-items rule))))"}

 {:id :range-is-its-own-requirement
  :invariant "（２）範囲指定 is checked separately from （１）"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (and (contains? required :range) (not (true? range-search?)))"
  :replace "      (and (contains? required :range) (not (some? range-search?)))"}

 {:id :combination-is-its-own-requirement
  :invariant "（３）二以上の組合せ is checked separately"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (and (contains? required :combination) (not (true? combination-search?)))"
  :replace "      (and (contains? required :combination) (not (some? combination-search?)))"}

 {:id :on-demand-is-the-gate-for-both-exemptions
  :invariant "unstated on-demand capability is :not-declared, not a tier"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (nil? (:can-produce-on-demand? setup))\n      {:taxlaw/coverage :not-declared"
  :replace "      (nil? (:can-produce-on-demand? nil))\n      {:taxlaw/coverage :not-declared"}

 {:id :on-demand-does-not-drop-the-record-items
  :invariant "the exemption drops ロ and ハ; イ stands"
  :file "src/kotoba/taxlaw.cljc"
  :find "                           on-demand? #{:items}"
  :replace "                           on-demand? #{}"}

 {:id :without-on-demand-all-three-are-required
  :invariant "no exemption means イ ロ ハ all apply"
  :file "src/kotoba/taxlaw.cljc"
  :find "                           :else #{:items :range :combination})"
  :replace "                           :else #{:items})"}

 {:id :the-wider-exemption-needs-on-demand-too
  :invariant "small sales alone does not drop 第五号 — 提示等 is required with it"
  :file "src/kotoba/taxlaw.cljc"
  :find "            wider (cond (not on-demand?) false"
  :replace "            wider (cond (not on-demand?) (or (true? small) (true? paper))"}

 {:id :the-sales-ceiling-is-inclusive
  :invariant "「五千万円以下」 — exactly the ceiling is inside it"
  :file "src/kotoba/taxlaw.cljc"
  :find "small (cond (number? sales) (<= sales ceiling) :else nil)"
  :replace "small (cond (number? sales) (< sales ceiling) :else nil)"}

 {:id :an-unstated-deciding-fact-is-not-a-failure
  :invariant "`you fail` and `you did not state the fact that decides it` differ"
  :file "src/kotoba/taxlaw.cljc"
  :find "        (if (and (seq missing) (nil? wider))"
  :replace "        (if (and (seq missing) (some? wider))"}

 {:id :refusing-to-conclude-still-informs
  :invariant ":not-declared still names what is missing"
  :file "src/kotoba/taxlaw.cljc"
  :find "           :taxlaw/missing missing\n           :taxlaw/provision (:rule/provision rule)}"
  :replace "           :taxlaw/missing #{}\n           :taxlaw/provision (:rule/provision rule)}"}

 {:id :the-book-rule-is-not-an-unconditional-duty
  :invariant "requires-book-search? answers with the condition, not `true`"
  :file "src/kotoba/taxlaw.cljc"
  :find "    {:rule/required-only-when :claiming-preferential-treatment"
  :replace "    {:rule/required-only-when true"}

 {:id :the-two-regimes-quote-different-text
  :invariant "帳簿 has no 「その他の日付」 and no sales ceiling"
  :file "src/kotoba/taxlaw.cljc"
  :find "     :rule/quote (str \"ハ当該国税関係帳簿に係る電磁的記録の記録事項の検索を\""
  :replace "     :rule/small-holder-sales-ceiling-yen 50000000\n     :rule/quote (str \"ハ当該国税関係帳簿に係る電磁的記録の記録事項の検索をその他の日付を\""}

 {:id :the-conservative-boolean-stays-conservative
  :invariant "book-search-adequate? is false for :none and :not-declared"
  :file "src/kotoba/taxlaw.cljc"
  :find "  (true? (:taxlaw/adequate? (book-search j books))))"
  :replace "  (not (false? (:taxlaw/adequate? (book-search j books)))))"}

 ;; --- 消費税額等, 施行令 第七十条の十 ---

 {:id :the-method-is-not-defaulted
  :invariant "「いずれかとする」 — the issuer picks, so the library does not"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (nil? (get methods method))"
  :replace "      (nil? (get methods (or method :tax-exclusive)))"}

 {:id :the-rounding-is-not-defaulted
  :invariant "the article says 端数を処理する and names no direction"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (not (contains? (:rule/rounding-policies rule) rounding))"
  :replace "      (not (contains? (:rule/rounding-policies rule) (or rounding :floor)))"}

 {:id :floor-and-ceil-are-different
  :invariant "an inexact figure moves under :ceil and does not under :floor"
  :file "src/kotoba/taxlaw.cljc"
  :find "            (= :ceil policy) (inc q)"
  :replace "            (= :ceil policy) q"}

 {:id :half-up-turns-on-the-half
  :invariant "「四捨五入」 — 5 rounds up, 4 does not"
  :file "src/kotoba/taxlaw.cljc"
  :find "            (= :round-half-up policy) (if (>= (* 2 r) den) (inc q) q)"
  :replace "            (= :round-half-up policy) (if (> (* 2 r) den) (inc q) q)"}

 {:id :an-exact-figure-is-left-alone
  :invariant "「端数が生じたときは」 — when none arises, nothing is processed"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (cond (zero? r) q\n            (= :floor policy) q"
  :replace "      (cond (zero? r) (inc q)\n            (= :floor policy) q"}

 {:id :a-negative-subtotal-is-refused
  :invariant "quot truncates toward zero; :floor on a negative rounds UP"
  :file "src/kotoba/taxlaw.cljc"
  :find "  (when (and (integer? num) (>= num 0) (pos? den))"
  :replace "  (when (and (number? num) (pos? den))"}

 {:id :an-unknown-tax-category-is-refused
  :invariant "refusing to treat an unread category as 標準 or 軽減"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (seq (remove known (keys subtotals)))"
  :replace "      (seq (remove some? (keys subtotals)))"}

 {:id :the-reduced-rate-is-not-the-standard-rate
  :invariant "軽減税率 8/100 and 8/108, read off the text"
  :file "src/kotoba/taxlaw.cljc"
  :find "     {:tax-exclusive {:statute \"第一号（税抜価額）\"\n                      :standard [10 100] :reduced [8 100]}"
  :replace "     {:tax-exclusive {:statute \"第一号（税抜価額）\"\n                      :standard [10 100] :reduced [10 100]}"}

 {:id :tax-inclusive-divides-by-110-not-100
  :invariant "第二号 税込 — 百十分の十, not 百分の十"
  :file "src/kotoba/taxlaw.cljc"
  :find "                      :standard [10 110] :reduced [8 108]}"
  :replace "                      :standard [10 100] :reduced [8 108]}"}

 ;; A 26th was written and REMOVED, with the reason, because deleting one to
 ;; make a table clean is the thing this harness exists to prevent and the
 ;; reason must therefore survive the deletion:
 ;;
 ;;   :a-refusal-yields-nil-and-never-a-partial-figure — dropping the
 ;;   `(= :checked ...)` guard in `consumption-tax` reddened nothing, and it
 ;;   turned out to be a semantic no-op: every refusal map lacks
 ;;   `:taxlaw/tax`, so `(:taxlaw/tax r)` is nil on all of them anyway. The
 ;;   guard is correct and cheap and stays, but it is structural defence
 ;;   against a future refusal branch, NOT an invariant anything can observe
 ;;   today, and claiming it as one would be the same overreach as a green
 ;;   check that never ran.

 {:id :an-empty-invoice-is-a-real-zero-not-a-refusal
  :invariant "0 tax is an answer; it must not be what `could not answer` looks like"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (not (map? subtotals))"
  :replace "      (not (seq subtotals))"}

 ;; --- coverage is per facet, and per question (2026-08-18) ---

 {:id :credit-support-gates-on-its-own-facet
  :invariant "a catalogued jurisdiction with no invoice rule does not approve a claim"
  :file "src/kotoba/taxlaw.cljc"
  :find "    (if (nil? (facet-of path :jurisdiction/input-tax-credit))"
  :replace "    (if (not (covered? path))"}

 {:id :preservation-gates-on-the-question-not-the-facet
  :invariant "an EU facet that answers a different question is not an answer"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (nil? (:rule/must-preserve-electronic-record?\n             (facet-of path :jurisdiction/electronic-transaction)))"
  :replace "      (nil? (facet-of path :jurisdiction/electronic-transaction))"}

 {:id :retention-gates-on-its-own-facet
  :invariant "retention answers :none for a jurisdiction whose retention was not read"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (nil? (facet-of path :jurisdiction/retention))"
  :replace "      (nil? (facet-of path :jurisdiction/label))"}

 {:id :withholding-gates-on-its-own-facet
  :invariant "withholding answers :none where no withholding rule was read"
  :file "src/kotoba/taxlaw.cljc"
  :find "      (nil? (facet-of path :jurisdiction/wage-withholding))"
  :replace "      (nil? (facet-of path :jurisdiction/label))"}

 {:id :out-of-scope-is-still-not-a-pass
  :invariant ":none is preserved so a consumer that never heard of it still holds"
  :file "src/kotoba/taxlaw.cljc"
  :find "    (cond-> {:taxlaw/coverage :none :taxlaw/unchecked [path]}"
  :replace "    (cond-> {:taxlaw/coverage (if why :out-of-scope :none) :taxlaw/unchecked [path]}"}

 ;; --- [:eu] and [:us]: mostly what the instruments do NOT say ---

 {:id :the-eu-states-no-retention-period
  :invariant "Article 247(1) hands the period to the Member State"
  :file "src/kotoba/taxlaw.cljc"
  :find "    {:rule/years nil\n     :rule/period-set-by :member-state"
  :replace "    {:rule/years 10\n     :rule/period-set-by :member-state"}

 {:id :the-us-states-no-retention-period
  :invariant "26 CFR 1.6001-1(e) states a condition, not a number"
  :file "src/kotoba/taxlaw.cljc"
  :find "    {:rule/years nil\n     :rule/period-set-by :materiality"
  :replace "    {:rule/years 7\n     :rule/period-set-by :materiality"}

 {:id :the-eu-prefix-must-be-two-uppercase-letters
  :invariant "Article 215: an ISO 3166 alpha-2 prefix"
  :file "src/kotoba/taxlaw.cljc"
  :find "     :rule/registration-number-pattern #\"[A-Z]{2}[0-9A-Za-z+*.]+\""
  :replace "     :rule/registration-number-pattern #\"[A-Za-z]{2}[0-9A-Za-z+*.]+\""}

 {:id :the-eu-prefix-needs-a-body-after-it
  :invariant "a bare prefix is not a VAT identification number"
  :file "src/kotoba/taxlaw.cljc"
  :find "#\"[A-Z]{2}[0-9A-Za-z+*.]+\""
  :replace "#\"[A-Z]{2}[0-9A-Za-z+*.]*\""}

 {:id :the-format-limits-ride-on-the-answer
  :invariant "a `true` says what it did not look at"
  :file "src/kotoba/taxlaw.cljc"
  :find "         :taxlaw/registration-format\n         (get-in jurisdictions [path :jurisdiction/input-tax-credit\n                                :rule/registration-format])"
  :replace "         :taxlaw/registration-format nil"}

 {:id :the-eu-does-not-inherit-japans-preservation-duty
  :invariant "Article 218 obliges the Member State to accept, not the holder to preserve"
  :file "src/kotoba/taxlaw.cljc"
  :find "    {:rule/electronic-form-must-be-accepted? true"
  :replace "    {:rule/must-preserve-electronic-record? true\n     :rule/electronic-form-must-be-accepted? true"}

 {:id :a-member-state-is-not-covered-by-its-union
  :invariant "the Directive hands answers down; [:eu :de] is not [:eu]"
  :file "src/kotoba/taxlaw.cljc"
  :find "  [jurisdiction]\n  (contains? jurisdictions (normalize jurisdiction)))"
  :replace "  [jurisdiction]\n  (let [p (normalize jurisdiction)]\n    (boolean (some #(contains? jurisdictions (vec (take % p))) (range 1 (inc (count p)))))))"}]